{
  "name": "reporter",
  "version": "0.11.0",
  "private": true,
  "description": "reporter — evidence collection and reporting toolkit for security engagements",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "postinstall": "node scripts/fix-node-pty.mjs",
    "build": "pnpm -r --filter \"./packages/*\" build && pnpm -r --filter \"./apps/*\" build",
    "dev:server": "pnpm --filter @reporter/server dev",
    "dev:web": "pnpm --filter @reporter/web dev",
    "dev:desktop": "pnpm --filter @reporter/desktop dev",
    "test": "vitest run",
    "test:all": "vitest run && pnpm --filter @reporter/server test",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "version:bump": "node scripts/bump-version.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@reporter/api-client": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.4.2",
    "sharp": "^0.33.5",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.2"
  },
  "pnpm": {
    "overrides": {
      "node-gyp": "^11.0.0"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "prisma",
      "@prisma/client",
      "@prisma/engines",
      "sharp",
      "@node-rs/argon2",
      "better-sqlite3",
      "electron",
      "node-pty",
      "puppeteer"
    ]
  }
}
