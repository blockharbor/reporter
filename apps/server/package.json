{
  "name": "@reporter/server",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "seed": "tsx --env-file=.env prisma/seed.ts",
    "clean": "rm -rf dist"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.0.4",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^6.2.1",
    "@reporter/api-client": "workspace:*",
    "@reporter/shared": "workspace:*",
    "archiver": "^5.3.2",
    "busboy": "^1.6.0",
    "fastify": "^5.2.1",
    "otpauth": "^9.3.6",
    "puppeteer": "^23.11.1",
    "sharp": "^0.33.5",
    "yauzl": "^2.10.0",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.726.1"
  },
  "devDependencies": {
    "@types/archiver": "^5.3.4",
    "@types/busboy": "^1.5.4",
    "@types/node": "^22.10.5",
    "@types/yauzl": "^2.10.3",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  }
}
