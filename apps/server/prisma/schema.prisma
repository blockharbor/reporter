// reporter data model — the source of truth for the whole system.
// Change shape here, then `prisma migrate dev --name <change>`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EngagementStatus {
  active
  complete
  archived
}

enum EngagementRole {
  admin
  write
  read
}

enum AuthScheme {
  local
  oidc
  recovery
}

enum SavedQueryType {
  evidence
  findings
}

/** Qualitative finding severity, matching the CVSS v3.1 severity rating scale. */
enum Severity {
  none
  low
  medium
  high
  critical
}

/** Estimated effort to remediate a finding. */
enum FixEffort {
  none
  low
  medium
  high
}

/** Whether a finding records a weakness (default) or a security strength. */
enum FindingKind {
  weakness
  strength
}

/**
 * Lifecycle state of a single engagement goal (an area of interest under a
 * testing activity). Progress rolls up from these: a goal advances to
 * `in_progress` automatically when its first evidence/finding is linked, and to
 * `complete` when the operator marks it done. `not_applicable` goals are
 * excluded from the completion denominator.
 */
enum GoalStatus {
  not_started
  in_progress
  complete
  not_applicable
}

model User {
  id        Int       @id @default(autoincrement())
  slug      String    @unique
  firstName String    @map("first_name")
  lastName  String    @map("last_name")
  email     String    @unique
  admin     Boolean   @default(false)
  disabled  Boolean   @default(false)
  headless  Boolean   @default(false)
  /**
   * Legacy soft-delete marker. Deleting a user is now a hard delete (the row is
   * really removed and its evidence is anonymized), so this only ever shadows rows
   * soft-deleted by the old endpoint; the auth guards still check it so those rows
   * stay locked out.
   */
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  identities   AuthIdentity[]
  webauthn     WebauthnCredential[]
  recovery     RecoveryCode[]
  apiKeys      ApiKey[]
  sessions     Session[]
  roles        UserEngagementRole[]
  prefs        UserEngagementPref[]
  evidencePrefs UserEvidencePref[]
  evidence     Evidence[]         @relation("EvidenceOperator")
  editedEvidence Evidence[]       @relation("EvidenceLastEditor")
  evidenceComments EvidenceComment[]
  generatedReports GeneratedReport[]

  @@map("users")
}

model AuthIdentity {
  id                Int        @id @default(autoincrement())
  userId            Int        @map("user_id")
  scheme            AuthScheme
  identifier        String
  passwordHash      String?    @map("password_hash")
  mustResetPassword Boolean    @default(false) @map("must_reset_password")
  totpSecret        String?    @map("totp_secret")
  lastLogin         DateTime?  @map("last_login")
  createdAt         DateTime   @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([scheme, identifier])
  @@index([userId])
  @@map("auth_identities")
}

model WebauthnCredential {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  credentialId Bytes    @unique @map("credential_id")
  publicKey    Bytes    @map("public_key")
  signCount    Int      @default(0) @map("sign_count")
  transports   String?
  name         String
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("webauthn_credentials")
}

model RecoveryCode {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  codeHash  String    @unique @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("recovery_codes")
}

model ApiKey {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  accessKey String    @unique @map("access_key")
  secretKey Bytes     @map("secret_key")
  lastAuth  DateTime? @map("last_auth")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}

model Session {
  id        String   @id // sha256 hex of the cookie token
  userId    Int      @map("user_id")
  data      Json?
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Engagement {
  id        Int             @id @default(autoincrement())
  slug      String          @unique
  name      String
  status    EngagementStatus @default(active)
  // Lifecycle dates. `startedAt` defaults to creation time but is editable.
  // `projectedEndAt` is an operator-entered target. `actualEndAt` is stamped when
  // the engagement leaves `active` (into complete/archived) and cleared on return.
  startedAt      DateTime  @default(now()) @map("started_at")
  projectedEndAt DateTime? @map("projected_end_at")
  actualEndAt    DateTime? @map("actual_end_at")
  // Optional report metadata. Surfaced on the exported findings-report PDF (cover,
  // engagement-details page, executive summary, methodology). All null-until-set.
  clientName       String? @map("client_name")
  assessmentType   String? @map("assessment_type")
  location         String?
  scope            String?
  executiveSummary String? @map("executive_summary")
  methodology      String?
  // Per-engagement report watermark, drawn on every page of the exported PDF
  // except the title page. `watermarkText` null → "CONFIDENTIAL"; `watermarkColor`
  // null → a neutral gray. Opacity is one of light|medium|strong; layer is
  // behind|front (under vs. above the page content).
  watermarkEnabled Boolean @default(true) @map("watermark_enabled")
  watermarkText    String? @map("watermark_text")
  watermarkColor   String? @map("watermark_color")
  watermarkOpacity String  @default("medium") @map("watermark_opacity")
  watermarkLayer   String  @default("behind") @map("watermark_layer")
  // Structured report content, all editable in Engagement Settings and rendered
  // into the exported PDF. The list-shaped fields are JSON (jsonb) arrays whose
  // item shapes are validated by zod in @reporter/shared and default to `[]`.
  // `threatModelNarrative` is prose, like `executiveSummary`.
  scopeTargets             Json    @default("[]") @map("scope_targets")
  scopeExclusions          Json    @default("[]") @map("scope_exclusions")
  strategicRecommendations Json    @default("[]") @map("strategic_recommendations")
  threatModelNarrative     String? @map("threat_model_narrative")
  threatModelDiagrams      Json    @default("[]") @map("threat_model_diagrams")
  executionNarrative       Json    @default("[]") @map("execution_narrative")
  providerContacts         Json    @default("[]") @map("provider_contacts")
  clientContacts           Json    @default("[]") @map("client_contacts")
  softwareTested           Json    @default("[]") @map("software_tested")
  thirdPartySoftware       Json    @default("[]") @map("third_party_software")
  // Test approach (e.g. "Gray Box") and the narrative statement of engagement
  // objectives, both often seeded from an imported proposal. `objectivesNarrative`
  // heads the Goals tab and can also feed the report.
  testApproach        String? @map("test_approach")
  objectivesNarrative String? @map("objectives_narrative")
  // Report composition: an ordered, toggleable section list + options driving the
  // exported report (Reports tab). Empty object means "use the canonical default
  // flow"; the shape is validated by reportConfigSchema in @reporter/shared.
  reportConfig Json @default("{}") @map("report_config")
  // Raw JSON of the last imported proposal, kept verbatim for provenance/audit.
  proposalImport Json? @map("proposal_import")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  roles       UserEngagementRole[]
  prefs       UserEngagementPref[]
  evidence    Evidence[]
  findings    Finding[]
  tags        Tag[]
  categories  FindingCategory[]
  savedQueries SavedQuery[]
  targets     EngagementTarget[]
  generatedReports GeneratedReport[]

  @@map("engagements")
}

/**
 * A system/device under scope for an engagement (proposal "device"). The top of
 * the goal hierarchy: Target → Activity → Goal. Ordered manually for the report's
 * Scope & Objectives Coverage section.
 */
model EngagementTarget {
  id           Int      @id @default(autoincrement())
  engagementId Int      @map("engagement_id")
  name         String
  description  String   @default("")
  position     Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  engagement Engagement       @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  activities TargetActivity[]

  @@index([engagementId, position])
  @@map("engagement_targets")
}

/**
 * A testing activity performed against a target (proposal "interface"), with a
 * category (e.g. "Software / Application"). Each activity gets an engagement tag
 * (`tagId`) so evidence tagged with it correlates to the activity on the timeline;
 * the tag is cleared (SetNull) if deleted, leaving the activity intact.
 */
model TargetActivity {
  id        Int      @id @default(autoincrement())
  targetId  Int      @map("target_id")
  name      String
  category  String   @default("")
  tagId     Int?     @map("tag_id")
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  target EngagementTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  tag    Tag?             @relation(fields: [tagId], references: [id], onDelete: SetNull)
  goals  ActivityGoal[]

  @@index([targetId, position])
  @@index([tagId])
  @@map("target_activities")
}

/**
 * A goal / area of interest under an activity (proposal "subItem") — the
 * trackable unit. `isRetest` flags a goal carried over from a prior report (e.g.
 * a "W1-…" retest item). Evidence and findings link to it to drive progress.
 */
model ActivityGoal {
  id         Int        @id @default(autoincrement())
  activityId Int        @map("activity_id")
  title      String
  status     GoalStatus @default(not_started)
  isRetest   Boolean    @default(false) @map("is_retest")
  notes      String     @default("")
  position   Int        @default(0)
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  activity TargetActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  evidence GoalEvidence[]
  findings GoalFinding[]

  @@index([activityId, position])
  @@map("activity_goals")
}

model GoalEvidence {
  goalId     Int      @map("goal_id")
  evidenceId Int      @map("evidence_id")
  createdAt  DateTime @default(now()) @map("created_at")

  goal     ActivityGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  evidence Evidence     @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@id([goalId, evidenceId])
  @@index([evidenceId])
  @@map("goal_evidence")
}

model GoalFinding {
  goalId    Int      @map("goal_id")
  findingId Int      @map("finding_id")
  createdAt DateTime @default(now()) @map("created_at")

  goal    ActivityGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  finding Finding      @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@id([goalId, findingId])
  @@index([findingId])
  @@map("goal_findings")
}

model UserEngagementRole {
  id          Int           @id @default(autoincrement())
  userId      Int           @map("user_id")
  engagementId Int           @map("engagement_id")
  role        EngagementRole

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@unique([userId, engagementId])
  @@index([engagementId])
  @@map("user_engagement_roles")
}

model UserEngagementPref {
  id          Int     @id @default(autoincrement())
  userId      Int     @map("user_id")
  engagementId Int     @map("engagement_id")
  isFavorite  Boolean @default(false) @map("is_favorite")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@unique([userId, engagementId])
  @@map("user_engagement_prefs")
}

model UserEvidencePref {
  id         Int     @id @default(autoincrement())
  userId     Int     @map("user_id")
  evidenceId Int     @map("evidence_id")
  isFavorite Boolean @default(false) @map("is_favorite")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([userId, evidenceId])
  @@map("user_evidence_prefs")
}

model Tag {
  id          Int    @id @default(autoincrement())
  engagementId Int    @map("engagement_id")
  name        String
  colorName   String @map("color_name")

  engagement Engagement     @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  evidence  EvidenceTag[]
  activities TargetActivity[]

  @@unique([engagementId, name])
  @@index([engagementId])
  @@map("tags")
}

model DefaultTag {
  id        Int    @id @default(autoincrement())
  name      String @unique
  colorName String @map("color_name")

  @@map("default_tags")
}

/**
 * Site-wide branding for generated report PDFs. A single row (id = 1); the
 * service layer upserts/reads that one row. `logoDataUri` holds an inline
 * data: URI (small PNG/SVG) so the logo embeds directly in the PDF with no
 * blob-store round-trip. Defaults ship the Block Harbor house style.
 */
model ReportSettings {
  id               Int      @id @default(1)
  organizationName String   @default("Block Harbor") @map("organization_name")
  accentColor      String   @default("#e82434") @map("accent_color")
  logoDataUri      String?  @map("logo_data_uri")
  footerNote       String?  @map("footer_note")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("report_settings")
}

/**
 * The audit trail behind the Reports tab: one row per report document (PDF or
 * ZIP) generated for an engagement. Reports themselves render on demand and are
 * never stored, so this is deliberately lean — `version` is an auto-assigned
 * label (`v1.0`, `v2.0`, …) and `summary` is a JSON snapshot of the findings
 * tallies at generation time (shape: `reportSummarySchema` in @reporter/shared).
 * An attestation letter attests to one of these records so its stated results
 * stay consistent with the report even after the engagement's findings change.
 */
model GeneratedReport {
  id            Int      @id @default(autoincrement())
  uuid          String   @unique @default(uuid())
  engagementId  Int      @map("engagement_id")
  preset        String
  label         String
  version       String
  format        String
  summary       Json
  // Stored artifact: the rendered bytes live in the blob store (never the DB) so
  // the exact deliverable can be re-downloaded. Nullable because the bytes are
  // stored best-effort after the row is written, and because rows generated
  // before artifact storage have no file.
  blobKey       String?  @map("blob_key")
  filename      String?
  sizeBytes     Int?     @map("size_bytes")
  contentType   String?  @map("content_type")
  sha256        String?
  generatedById Int?     @map("generated_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  engagement  Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  generatedBy User?      @relation(fields: [generatedById], references: [id], onDelete: SetNull)

  @@index([engagementId, createdAt])
  @@map("generated_reports")
}

model Evidence {
  id             Int      @id @default(autoincrement())
  uuid           String   @unique @default(uuid())
  engagementId    Int      @map("engagement_id")
  // Who captured this evidence. Null means that user was deleted: the evidence is
  // the client deliverable and outlives its author, so the row survives the delete
  // (ON DELETE SET NULL) and every display site renders "Deleted user".
  operatorId     Int?     @map("operator_id")
  // Short label for the evidence — the primary heading in lists, cards, and the
  // report. Backfilled from the old description on the title migration; required
  // on new evidence at the API/UI layer.
  title          String   @default("")
  description    String   @default("")
  contentType    String   @map("content_type")
  contentSubtype String?  @map("content_subtype")
  // Original uploaded filename, when known. Used to name files in the report's
  // supporting-files ZIP bundle and the "Files Attached" table; synthesized from
  // the description + content type when absent (older evidence).
  originalFilename String? @map("original_filename")
  fullBlobKey    String?  @map("full_blob_key")
  thumbBlobKey   String?  @map("thumb_blob_key")
  // SHA-256 (hex) and byte size of the stored blob, computed once at upload. Lets
  // the report's supporting-files table list hashes/sizes without re-reading every
  // blob on each export. Null for evidence created before this existed (the report
  // then falls back to hashing the blob on demand).
  sha256         String?  @map("sha256")
  sizeBytes      Int?     @map("size_bytes")
  // When set, this evidence is a comment (linked evidence) on another piece of
  // evidence. Enforced one level deep in the service layer. SetNull so deleting
  // a parent orphans its comments into top-level evidence rather than erroring;
  // the web delete handler offers an explicit cascade instead.
  parentEvidenceId Int?   @map("parent_evidence_id")
  occurredAt     DateTime @map("occurred_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  // Who last edited any field of this evidence (null until first edit). Distinct
  // from `operatorId`, which is always the original capturer.
  lastEditedById Int?     @map("last_edited_by_id")
  /** When true this evidence is omitted from every report output — the PDF, the
      supporting-files ZIP and the JSON export. It stays fully visible in the app. */
  excludeFromReport Boolean @default(false) @map("exclude_from_report")

  engagement Engagement          @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  operator  User?              @relation("EvidenceOperator", fields: [operatorId], references: [id], onDelete: SetNull)
  lastEditedBy User?            @relation("EvidenceLastEditor", fields: [lastEditedById], references: [id], onDelete: SetNull)
  parent    Evidence?          @relation("EvidenceComments", fields: [parentEvidenceId], references: [id], onDelete: SetNull)
  comments  Evidence[]         @relation("EvidenceComments")
  // Plain-text discussion comments (the user-facing "Comments"), distinct from the
  // `comments` self-relation above which models linked evidence.
  commentThread EvidenceComment[]
  tags      EvidenceTag[]
  findings  EvidenceFinding[]
  metadata  EvidenceMetadata[]
  userPrefs UserEvidencePref[]
  goals     GoalEvidence[]

  @@index([engagementId, occurredAt])
  @@index([parentEvidenceId])
  @@map("evidence")
}

/// A plain-text discussion comment on a piece of evidence (the user-facing
/// "Comments"). Internal notes only — never included in the exported report.
model EvidenceComment {
  id         Int      @id @default(autoincrement())
  uuid       String   @unique @default(uuid())
  evidenceId Int      @map("evidence_id")
  // Who wrote the comment. Null means that user was deleted — the comment stays on
  // the evidence thread and the UI renders its author as "Deleted user".
  authorId   Int?     @map("author_id")
  body       String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  author   User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([evidenceId, createdAt])
  @@map("evidence_comments")
}

model EvidenceMetadata {
  id         Int    @id @default(autoincrement())
  evidenceId Int    @map("evidence_id")
  source     String
  body       String @default("")
  status     String @default("complete")

  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, source])
  @@map("evidence_metadata")
}

model FindingCategory {
  id           Int       @id @default(autoincrement())
  engagementId Int       @map("engagement_id")
  category     String
  deletedAt    DateTime? @map("deleted_at")

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  findings   Finding[]

  // Categories are per-engagement: the same name may exist under different
  // engagements, but is unique within one.
  @@unique([engagementId, category])
  @@index([engagementId])
  @@map("finding_categories")
}

model Finding {
  id            Int       @id @default(autoincrement())
  uuid          String    @unique @default(uuid())
  engagementId  Int       @map("engagement_id")
  categoryId    Int?      @map("category_id")
  title         String
  description   String    @default("")
  /** Whether this finding is a weakness (default) or a security strength. */
  kind          FindingKind @default(weakness)
  /** System/component the finding applies to (e.g. a subsystem or host). */
  affectedTarget String   @default("") @map("affected_target")
  /** Business/technical impact if exploited — distinct from the description. */
  impact        String    @default("")
  /** Estimated remediation effort (weaknesses only). */
  fixEffort     FixEffort @default(none) @map("fix_effort")
  /** Recommended remediation / fix guidance, shown per-finding in the report. */
  remediation   String    @default("")
  /** Mapped ISO/SAE 21434 work-product/clause reference IDs (catalog in @reporter/shared). */
  iso21434Refs  Json      @default("[]") @map("iso21434_refs")
  /** Mapped UN R155 requirement reference IDs (catalog in @reporter/shared). */
  unr155Refs    Json      @default("[]") @map("unr155_refs")
  severity      Severity?
  cvssVector    String?   @map("cvss_vector")
  cvssScore     Float?    @map("cvss_score")
  position      Int       @default(0)
  readyToReport Boolean   @default(false) @map("ready_to_report")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  engagement Engagement         @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  category  FindingCategory?  @relation(fields: [categoryId], references: [id])
  evidence  EvidenceFinding[]
  goals     GoalFinding[]

  @@index([engagementId, position])
  @@map("findings")
}

model EvidenceTag {
  evidenceId Int @map("evidence_id")
  tagId      Int @map("tag_id")

  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([evidenceId, tagId])
  @@index([tagId])
  @@map("evidence_tags")
}

model EvidenceFinding {
  evidenceId Int     @map("evidence_id")
  findingId  Int     @map("finding_id")
  position   Int     @default(0)
  caption    String  @default("")
  inPath     Boolean @default(false) @map("in_path")

  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  finding  Finding  @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@id([evidenceId, findingId])
  @@index([findingId])
  @@map("evidence_findings")
}

model SavedQuery {
  id          Int            @id @default(autoincrement())
  engagementId Int            @map("engagement_id")
  name        String
  query       String
  type        SavedQueryType

  engagement Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  @@unique([engagementId, name, type])
  @@map("saved_queries")
}
