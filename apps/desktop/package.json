{
  "name": "@reporter/desktop",
  "version": "0.12.0",
  "private": true,
  "description": "reporter desktop — tray app for screenshot & codeblock capture",
  "author": "reporter",
  "homepage": "https://github.com/reporter-ops/reporter",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
