{
  "name": "@reporter/term",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "description": "reporter-term — record terminal sessions and upload them as evidence",
  "bin": {
    "reporter-term": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "node build.mjs",
    "pack": "node build.mjs && node scripts/make-tarball.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist pkg *.tgz"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "@reporter/api-client": "workspace:*",
    "@reporter/shared": "workspace:*",
    "commander": "^13.0.0",
    "env-paths": "^3.0.0",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
